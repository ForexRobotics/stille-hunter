{
  "_comment": "Copy this to a private folder (e.g. ~/.stille/config.json, never a repository) and fill in real values. Pass with: stille-hunter check <ledger> --sources hibp,github --config ~/.stille/config.json. Remove the channels under \"notify\" you do not use.",
  "hibp": {
    "api_key": "YOUR_32_CHAR_HIBP_API_KEY_HERE",
    "user_agent": "stille-hunter-yourorg",
    "min_interval": 6.5,
    "include_unverified": true
  },
  "github": {
    "token": "YOUR_GITHUB_PAT_HERE",
    "user_agent": "stille-hunter-yourorg",
    "min_interval": 6.5
  },
  "inbox": {
    "domain": "your-trap-domain.net",
    "imap": {
      "host": "imap.your-provider.net",
      "user": "YOUR_MAILBOX_USER",
      "password": "YOUR_APP_PASSWORD",
      "folder": "INBOX"
    },
    "days": 7
  },
  "notify": {
    "webhook": {
      "url": "https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
    },
    "email": {
      "host": "smtp.example.org",
      "port": 587,
      "security": "starttls",
      "username": "YOUR_SMTP_USER",
      "password": "YOUR_SMTP_PASSWORD",
      "from": "alerts@example.org",
      "to": [
        "secops@example.org"
      ]
    },
    "on_errors": true
  }
}
